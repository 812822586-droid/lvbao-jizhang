.head { border-top: 12rpx solid #0e6b3a; }
.head-name { font-size: 42rpx; font-weight: 700; color: #0e4a2b; margin-bottom: 16rpx; }
.total { font-size: 56rpx; font-weight: 700; color: #0e6b3a; }
.unit { font-size: 28rpx; font-weight: 400; }
.status { font-size: 28rpx; color: #9a3412; background: #fff1ea; padding: 8rpx 24rpx; border-radius: 32rpx; }
.status.ok { color: #0e6b3a; background: #e5f6ec; }
.member { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 2rpx solid #d5e6da; font-size: 32rpx; }
.link-btn { color: #9a3412; font-size: 28rpx; padding: 12rpx 16rpx; }
.add-row { margin-top: 24rpx; }
.add-btn { margin-left: 16rpx; flex-shrink: 0; }
.nomb { margin-bottom: 0; }
.exp { display: flex; align-items: center; padding: 26rpx 0; border-bottom: 2rpx solid #d5e6da; }
.exp-title { font-size: 33rpx; font-weight: 600; }
.exp-amount { font-size: 36rpx; font-weight: 700; margin-left: 16rpx; color: #173024; }
.exp.gone { opacity: 0.6; }
.link-line { text-align: center; color: #0e6b3a; padding: 24rpx 0 4rpx; font-size: 28rpx; }
