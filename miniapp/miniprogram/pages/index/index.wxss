.month-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.month-btn { width: 88rpx; height: 88rpx; line-height: 80rpx; text-align: center; font-size: 52rpx; color: #0e6b3a; background: #fff; border-radius: 44rpx; box-shadow: 0 6rpx 18rpx rgba(16, 70, 40, 0.08); }
.month-title { font-size: 40rpx; font-weight: 700; color: #0e4a2b; }
.sum-row { display: flex; }
.sum-item { flex: 1; text-align: center; }
.sum-label { display: block; font-size: 26rpx; color: #3e5348; }
.sum-value { display: block; font-size: 40rpx; font-weight: 700; margin-top: 6rpx; word-break: break-all; }
.cat-row { margin-bottom: 22rpx; }
.bar-track { height: 16rpx; border-radius: 8rpx; background: #e5f6ec; margin-top: 8rpx; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 8rpx; min-width: 6rpx; }
.rec { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 2rpx solid #d5e6da; }
.rec:last-child { border-bottom: none; }
.dot { width: 20rpx; height: 20rpx; border-radius: 10rpx; margin-right: 20rpx; flex-shrink: 0; }
.rec-cat { font-size: 32rpx; font-weight: 600; }
.rec-amount { font-size: 36rpx; font-weight: 700; margin-left: 16rpx; }
